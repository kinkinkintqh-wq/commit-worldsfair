# This independent app never reads old Commit environment variables or keys.
COMMIT_WF_MODE=demo
COMMIT_WF_HOST=127.0.0.1
COMMIT_WF_PORT=4317
COMMIT_WF_ORIGIN=http://127.0.0.1:4317
# devnet only; never mainnet
COMMIT_WF_RPC=https://api.devnet.solana.com
# Official Circle Solana devnet USDC, 6 decimals, no financial value
COMMIT_WF_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Set automatically by devnet:setup; paths must stay inside this repo's .state/.
COMMIT_WF_OPERATOR_FILE=.state/operator.json
COMMIT_WF_PROVIDER_FILE=.state/provider.json
COMMIT_WF_STATE=.state/demo.sqlite
